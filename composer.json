{
    "name": "syofyanzuhad/lumina-core",
    "description": "Core models, migrations, and shared logic for Lumina analytics.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^13.0",
        "jenssegers/agent": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Lumina\\Core\\": "src/",
            "Lumina\\Core\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lumina\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lumina\\Core\\LuminaCoreServiceProvider"
            ]
        }
    }
}
