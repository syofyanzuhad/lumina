<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="PackageCore">
            <directory>packages/lumina-core/tests</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>packages/lumina-core/src</directory>
        </include>
    </source>
    <php>
        <!--
            Every entry below uses force="true". Without it, PHPUnit only sets
            a variable when it is not already present in the process
            environment — and `php artisan test` boots Laravel first, which
            putenv()s the dev `.env` values (APP_ENV=local, DB_CONNECTION=mysql)
            into the environment before PHPUnit runs. force="true" guarantees
            tests always boot with the testing environment and an isolated
            in-memory SQLite database, regardless of local .env state.
        -->
        <!--
            Two mechanisms are needed for deterministic tests:

            1. <server> entries — PHPUnit sets these in $_SERVER unconditionally.
               Laravel's environment repository reads $_SERVER first (immutable),
               so this overrides any variables exported by the shell / dev tooling
               (e.g. APP_ENV=local, DB_CONNECTION=mysql) before PHP even starts.

            2. <env> entries with force="true" — PHPUnit otherwise only sets a
               variable when it is not already present in the process environment,
               and `php artisan test` boots Laravel first, which putenv()s the dev
               `.env` values before PHPUnit runs.

            Together they guarantee tests always boot with the testing environment
            and an isolated in-memory SQLite database, regardless of local .env or
            shell state.
        -->
        <server name="APP_ENV" value="testing"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file"/>
        <server name="BCRYPT_ROUNDS" value="4"/>
        <server name="BROADCAST_CONNECTION" value="null"/>
        <server name="CACHE_STORE" value="array"/>
        <server name="DB_CONNECTION" value="sqlite"/>
        <server name="DB_DATABASE" value=":memory:"/>
        <server name="DB_URL" value=""/>
        <server name="MAIL_MAILER" value="array"/>
        <server name="QUEUE_CONNECTION" value="sync"/>
        <server name="SESSION_DRIVER" value="array"/>
        <server name="PULSE_ENABLED" value="false"/>
        <server name="TELESCOPE_ENABLED" value="false"/>
        <server name="NIGHTWATCH_ENABLED" value="false"/>

        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
